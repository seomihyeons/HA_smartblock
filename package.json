{
  "name": "ha_smartblock",
  "version": "1.3.0",
  "description": "Visual round-trip programming environment for Home Assistant automations",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "node --test test/ir/*.test.mjs server/tests/*.test.mjs",
    "test:ir": "node --test test/ir/*.test.mjs",
    "test:llm": "node --test server/tests/*.test.mjs",
    "benchmark:llm": "node server/benchmarks/run_automation_ab.mjs",
    "sbom": "node scripts/generate_spdx_sbom.mjs",
    "build": "webpack --mode production",
    "start": "webpack serve --mode development --open --hot"
  },
  "keywords": [
    "blockly",
    "home-assistant",
    "automation"
  ],
  "author": "",
  "license": "MIT AND Apache-2.0",
  "dependencies": {
    "ajv": "^8.17.1",
    "blockly": "^11.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "js-yaml": "^4.3.1"
  },
  "overrides": {
    "form-data": "4.0.6",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "css-loader": "^6.7.1",
    "html-webpack-plugin": "^5.5.0",
    "source-map-loader": "^4.0.1",
    "style-loader": "^3.3.1",
    "webpack": "^5.102.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  }
}
