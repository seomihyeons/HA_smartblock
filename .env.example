HA_BASE_URL=http://127.0.0.1:8123
HA_TOKEN=replace-with-a-long-lived-access-token

# Use ollama for the capability-driven assistant. fake is only a deterministic test fixture.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-q4_K_M
# Qwen3 structured drafting should run without a reasoning trace for lower latency.
OLLAMA_THINK=false
OLLAMA_SEED=42
OLLAMA_KEEP_ALIVE=30m
LLM_REQUEST_TIMEOUT_MS=120000
LLM_MAX_ENTITY_CARDS=16
# lexical is dependency-free. hybrid combines lexical and multilingual embeddings with RRF.
LLM_ENTITY_RETRIEVAL=lexical
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
LLM_EMBED_TIMEOUT_MS=30000

# Optional provider-neutral assistant. The public runtime has no provider SDK
# or credentials: inject a deployment-owned factory with
# SMARTBLOCK_LLM_CLIENT_FACTORY=package.module:function.
# The local compatibility entry point still works with the private adapter:
# python -m ha_llm_control.llm_assistant.api_server
# Public entry point: python -m smartblock_llm.api_server
# SMARTBLOCK_LLM_CLIENT_FACTORY=your_provider_adapter:get_llm_client
# LLM_ASSISTANT_BACKEND=provider_neutral
# LLM_ASSISTANT_API_URL=http://127.0.0.1:8792
# LLM_ASSISTANT_PROVIDER=chatgpt
# LLM_ASSISTANT_TIMEOUT_MS=120000
# Adaptive Output Budget v1 chooses 2000 for normal requests and 2400-3000
# for selected automation modifications. The Python runtime retries a
# recoverable output-format failure once at 3500 tokens.
