HA_BASE_URL=http://127.0.0.1:8123
HA_TOKEN=replace-with-a-long-lived-access-token

# Use ollama for the capability-driven assistant. fake is only a deterministic test fixture.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-q4_K_M
# Qwen3 structured drafting should run without a reasoning trace for lower latency.
OLLAMA_THINK=false
OLLAMA_SEED=42
OLLAMA_KEEP_ALIVE=30m
LLM_REQUEST_TIMEOUT_MS=120000
LLM_MAX_ENTITY_CARDS=16
# lexical is dependency-free. hybrid combines lexical and multilingual embeddings with RRF.
LLM_ENTITY_RETRIEVAL=lexical
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
LLM_EMBED_TIMEOUT_MS=30000

# Optional provider-neutral assistant. Its API keys remain only in
# ha_llm_control/llm_api/.env; the browser and Node server never receive them.
# Run: python -m ha_llm_control.llm_assistant.api_server
# LLM_ASSISTANT_BACKEND=provider_neutral
# LLM_ASSISTANT_API_URL=http://127.0.0.1:8792
# LLM_ASSISTANT_PROVIDER=chatgpt
# LLM_ASSISTANT_TIMEOUT_MS=120000
# LLM_ASSISTANT_MAX_TOKENS=1200
