HA_BASE_URL=http://127.0.0.1:8123
HA_TOKEN=replace-with-a-long-lived-access-token

# Provider-neutral LLM assistant (ChatGPT, Claude, Gemini, or Grok).
# A deployment-owned factory supplies the model SDK and credentials.
LLM_ASSISTANT_BACKEND=provider_neutral
LLM_ASSISTANT_API_URL=http://127.0.0.1:8792
LLM_ASSISTANT_PROVIDER=chatgpt
LLM_ASSISTANT_TIMEOUT_MS=120000
SMARTBLOCK_LLM_CLIENT_FACTORY=your_provider_adapter:get_llm_client
# python -m pip install -r smartblock_llm/requirements.txt
# python -m smartblock_llm.api_server

# Local Entity Card retrieval: lexical or FastEmbed hybrid with ONNX.
LLM_ENTITY_RETRIEVAL=fastembed_hybrid
FASTEMBED_MODEL=intfloat/multilingual-e5-small
LLM_ENTITY_CANDIDATE_LIMIT=24
LLM_GROUNDING_MIN_MARGIN=0.02

# Adaptive Output Budget v1: 2000 tokens for ordinary requests,
# 2400-3000 for edits, with one recoverable-format retry.

# HA Area/Device/Entity Registry metadata (read-only, WebSocket)
HA_AREA_REGISTRY_CACHE_TTL_MS=60000
HA_AREA_REGISTRY_TIMEOUT_MS=3000
