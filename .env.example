HA_BASE_URL=http://127.0.0.1:8123
HA_TOKEN=replace-with-a-long-lived-access-token

# Use fake for deterministic development or ollama for local model inference.
LLM_PROVIDER=fake
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-q4_K_M
# Qwen3 structured drafting should run without a reasoning trace for lower latency.
OLLAMA_THINK=false
OLLAMA_SEED=42
OLLAMA_KEEP_ALIVE=30m
LLM_REQUEST_TIMEOUT_MS=120000
LLM_MAX_ENTITY_CARDS=32
LLM_ENABLE_FAST_PATH=true
